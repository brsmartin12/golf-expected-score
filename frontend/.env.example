# Where the FastAPI backend is listening.
#
# Copy this file to `.env` to override the default. Vite only exposes variables
# prefixed with VITE_ to the browser -- a guard rail so that a stray secret in
# the environment can't be bundled into public JavaScript by accident.
#
# In production (step 9) this is set to the deployed backend URL in Vercel's
# dashboard, which is what keeps the frontend build environment-independent.
VITE_API_URL=http://127.0.0.1:8000
