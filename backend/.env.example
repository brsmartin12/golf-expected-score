# Copy to `.env` for local development. Never commit `.env` -- it holds
# credentials, and .gitignore already excludes it.

# The database to connect to. This default matches the docker-compose.yml at the
# repo root, so `docker compose up -d` then `pytest` works with no .env at all.
#
# In production this is set in the hosting dashboard (Railway/Render/Supabase)
# to that provider's connection string.
DATABASE_URL=postgresql+psycopg://golf:golf@127.0.0.1:5432/golf

# Set to 1 to log every SQL statement SQLAlchemy runs. Very useful while
# learning what the ORM does on your behalf; far too noisy to leave on.
SQL_ECHO=0
